<ui:FluentWindow x:Class="AntigravityManager.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:AntigravityManager.Desktop.Views" xmlns:localization="clr-namespace:AntigravityManager.Desktop.Modules.Localization.Views"
    Title="Antigravity Manager" Width="1160" Height="800" MinWidth="960" MinHeight="650"
    WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True"
    Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI, Microsoft YaHei UI"
    Closing="OnClosing">
  <ui:FluentWindow.Resources><CollectionViewSource x:Key="NavigationSource" Source="{Binding Navigation}"><CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="Group"/></CollectionViewSource.GroupDescriptions></CollectionViewSource></ui:FluentWindow.Resources>
  <Grid Background="{DynamicResource CanvasBrush}">
    <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition /><RowDefinition Height="36" /></Grid.RowDefinitions>
    <ui:TitleBar Title="Antigravity Manager" Padding="14,0,0,0" />
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="224" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="16,20,16,16">
          <StackPanel DockPanel.Dock="Top" Margin="10,0,0,28">
            <Border Background="{DynamicResource AccentBrush}" CornerRadius="10" Width="42" Height="42" HorizontalAlignment="Left" Margin="0,0,0,14"><TextBlock Text="A" Foreground="White" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock Text="Antigravity" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="MANAGER" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="10,18,0,0"><TextBlock Text="桌面管理工作台" Foreground="{DynamicResource MutedBrush}" FontSize="12" /><TextBlock Text="{Binding ManagerVersion}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" /></StackPanel>
          <ListBox ItemsSource="{Binding Source={StaticResource NavigationSource}}" SelectedItem="{Binding SelectedNavigation}" BorderThickness="0" Background="Transparent" Padding="0">
            <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="10,16,0,6"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Margin" Value="0,3" /><Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter /></Border><ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource CanvasBrush}" /></Trigger>
                  <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource NavigationSelectedBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger>
                </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="8,10"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="30" VerticalAlignment="Center" /><TextBlock Text="{Binding Title}" FontSize="14" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="34,28,34,16" MaxWidth="1050">
          <views:OverviewView Visibility="{Binding OverviewVisibility}" />
          <Grid Visibility="{Binding LocalizationVisibility}"><localization:LocalizationView DataContext="{Binding Localization}" /></Grid>


          <views:SettingsView Visibility="{Binding SettingsVisibility}" />
        </Grid>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><ProgressBar Grid.Column="1" Height="3" VerticalAlignment="Center" IsIndeterminate="True" Visibility="{Binding BusyVisibility}" /></Grid>
    </Border>
  </Grid>
</ui:FluentWindow>

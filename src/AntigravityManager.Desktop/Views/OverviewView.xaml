<UserControl x:Class="AntigravityManager.Desktop.Views.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <StackPanel>
    <TextBlock Text="工作台" Style="{StaticResource Heading}"/><TextBlock Text="按需打开功能模块，维护你的 Antigravity。" Style="{StaticResource Description}"/>
    <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="当前应用" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="Antigravity" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,10"/><TextBlock Text="{Binding ApplicationDirectory}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="1" CornerRadius="8" Padding="16,10" Margin="20,0,0,0" Background="{DynamicResource CanvasBrush}" VerticalAlignment="Top"><StackPanel><TextBlock Text="应用版本" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Localization.VersionLabel}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border></Grid></Border>
    <Grid Margin="0,12,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="功能模块" FontSize="18" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding ModuleCount, StringFormat={}{0} 个已启用}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid>
    <ItemsControl ItemsSource="{Binding Modules}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="40" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" CornerRadius="10" Background="{DynamicResource NavigationSelectedBrush}"><TextBlock Text="&#xE8C1;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel Grid.Column="1"><WrapPanel><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Margin="0,0,12,0"/><Border Background="{DynamicResource CanvasBrush}" CornerRadius="5" Padding="8,3"><TextBlock Text="{Binding Version, StringFormat=v{0}}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></Border></WrapPanel><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" Margin="0,10,16,0" TextWrapping="Wrap"/></StackPanel><ui:Button Grid.Column="2" Content="打开模块 →" Command="{Binding DataContext.OpenLocalizationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="更多功能将以独立模块扩展。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,32"/>
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0"><TextBlock Text="按需维护 · 无后台常驻 · 日常启动仍使用现有启动器" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/></Border>
  </StackPanel>
</UserControl>

<UserControl x:Class="AntigravityManager.Desktop.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <StackPanel><TextBlock Text="设置" Style="{StaticResource Heading}" /><TextBlock Text="管理安装位置、界面外观与本地数据。" Style="{StaticResource Description}" />
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Antigravity 安装目录" Style="{StaticResource SectionHeading}" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding ApplicationDirectory, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" VerticalContentAlignment="Center" Padding="10" /><ui:Button Grid.Column="1" Content="浏览…" Command="{Binding BrowseCommand}" Margin="10,0,0,0" /></Grid><TextBlock Text="选择包含 Antigravity.exe 和 resources 的目录。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" /></StackPanel></Border>
    <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="深色模式" Style="{StaticResource SectionHeading}" /><TextBlock Text="统一应用于管理器的所有页面。" Foreground="{DynamicResource MutedBrush}" /></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsDarkTheme}" VerticalAlignment="Center" /></Grid></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="数据目录" Style="{StaticResource SectionHeading}" /><TextBlock Text="{Binding DataDirectory, StringFormat=当前：{0}}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding PendingDataDirectory, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Padding="10" VerticalContentAlignment="Center"/><ui:Button Grid.Column="1" Content="浏览…" Command="{Binding BrowseDataCommand}" Margin="10,0,0,0"/></Grid><TextBlock Text="复制设置、汉化记录、备份和缓存并校验后切换，原目录保留。请选择新的或空目录。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" /><ui:Button Content="迁移并使用此目录" Command="{Binding MigrateDataCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border>
    <ui:Button Content="保存设置" Command="{Binding SaveSettingsCommand}" Appearance="Primary" HorizontalAlignment="Left" />
  </StackPanel>
</UserControl>

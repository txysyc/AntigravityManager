<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>AntigravityManager</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Branding/app-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Branding/app-icon.ico" />
    <Resource Include="Assets/Branding/app-icon.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <ProjectReference Include="../AntigravityManager.Core/AntigravityManager.Core.csproj" />
    <ProjectReference Include="../AntigravityManager.Infrastructure/AntigravityManager.Infrastructure.csproj" />
    <ProjectReference Include="../AntigravityManager.Modules.Localization/AntigravityManager.Modules.Localization.csproj" />
  </ItemGroup>
</Project>

<UserControl x:Class="AntigravityManager.Desktop.Modules.Localization.Views.BackupsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <StackPanel><TextBlock Text="汉化备份与恢复" Style="{StaticResource SectionHeading}" /><TextBlock Text="备份按应用版本与指纹保存，独立于应用安装目录。" Style="{StaticResource Description}" />
    <Border Style="{StaticResource Card}"><StackPanel><WrapPanel Margin="0,0,0,18"><ui:Button Content="刷新备份" Command="{Binding RefreshBackupsCommand}" Margin="0,0,12,0" /><ui:Button Content="恢复当前安装" Command="{Binding RestoreCommand}" /></WrapPanel><TextBlock Text="尚无管理器备份。安装受支持版本的补丁时，会先创建原始文件备份。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Visibility="{Binding EmptyBackupsVisibility}" /><ItemsControl ItemsSource="{Binding Backups}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8,0,12"><TextBlock Text="{Binding Version, StringFormat=Antigravity {0}}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding Path}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,0" /><TextBlock Text="{Binding Valid, StringFormat=SHA-256 校验通过：{0}}" FontSize="12" Margin="0,7,0,0" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  </StackPanel>
</UserControl>
